```prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  passwordHash  String
  role          Role     @default("PLAYER")
  balance       Int      @default(0)
  isActive      Boolean @default(true)
  cashierId     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions  Transaction[]
}

model Transaction {
  id            Int      @id @default(autoincrement())
  amount        Int
  type          Type     @default("CREDIT")
  fromUserId    Int?
  toUserId    Int?
  performedByUserId Int?
  timestamp     DateTime @default(now())
  auditReason   String?

  userFrom       User? @relation(fields: [fromUserId], references: [id])
  userTo         User? @relation(fields: [toUserId], references: [id])
  performedBy    User? @relation(fields: [performedByUserId], references: [id])
}

enum Role {
  SUPERADMIN
  ADMIN
  CASHIER
  PLAYER
}

enum Type {
  CREDIT
  DEBIT
  TRANSFER
}
```